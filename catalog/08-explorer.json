{
  "category": "explorer",
  "tweaks": [
    {
      "id": "explorer.show-extensions",
      "name": { "en": "Show file extensions & hidden files", "uk": "Показувати розширення та приховані файли" },
      "description": { "en": "Security basic: never be fooled by 'invoice.pdf.exe' again.", "uk": "База безпеки: більше не обдурять «invoice.pdf.exe»." },
      "risk": "safe", "weight": 2, "tags": ["recommended", "security"], "restartExplorer": true, "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "HideFileExt", "value": 0 },
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Hidden", "value": 1 }
      ]
    },
    {
      "id": "explorer.open-this-pc",
