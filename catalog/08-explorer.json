        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Classes\\CLSID\\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c}", "name": "System.IsPinnedToNameSpaceTree", "value": 0 }
      ]
    },
    {
