      ]
    },
    {
      "id": "explorer.compact-mode",
      "name": { "en": "Compact view (denser rows)", "uk": "Компактний вигляд (щільніші рядки)" },
      "description": { "en": "Windows 10-style spacing in file lists.", "uk": "Щільність списків, як у Windows 10." },
      "risk": "safe", "weight": 0, "tags": ["explorer"], "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "UseCompactMode", "value": 1 }
      ]
    },
    {
      "id": "explorer.no-shortcut-suffix",
      "name": { "en": "No '- Shortcut' suffix on new shortcuts", "uk": "Без суфікса «- Ярлик» у нових ярликах" },
      "description": { "en": "New shortcuts are named exactly like their target.", "uk": "Нові ярлики називаються як їх ціль." },
      "risk": "safe", "weight": 0, "tags": ["explorer"], "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer", "name": "link", "value": "00 00 00 00", "kind": "Binary" }
      ]
    },
    {
      "id": "explorer.no-lowdisk-nag",
      "name": { "en": "Disable low disk space warnings", "uk": "Вимкнути попередження про мало місця" },
      "description": { "en": "For small SSDs where the warning is a permanent annoyance.", "uk": "Для малих SSD, де попередження постійно дратує." },
      "risk": "safe", "weight": 0, "tags": ["annoyance"], "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "NoLowDiskSpaceChecks", "value": 1 }
      ]
    },
    {
      "id": "explorer.copy-move-to",
      "name": { "en": "Add 'Copy to' / 'Move to' to the context menu", "uk": "Додати «Копіювати в» / «Перемістити в» у контекстне меню" },
      "description": { "en": "Classic folder-picker actions on right-click (visible in the full context menu).", "uk": "Класичні дії з вибором теки у контекстному меню (у повному меню)." },
      "risk": "safe", "weight": 0, "tags": ["explorer"],
      "actions": [
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Classes\\AllFilesystemObjects\\shellex\\ContextMenuHandlers\\Copy To", "name": "(Default)", "value": "{C2FBB630-2971-11D1-A18C-00C04FD75D13}", "kind": "String" },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Classes\\AllFilesystemObjects\\shellex\\ContextMenuHandlers\\Move To", "name": "(Default)", "value": "{C2FBB631-2971-11D1-A18C-00C04FD75D13}", "kind": "String" }
      ]
    },
    {
      "id": "explorer.search-no-bing",
      "name": { "en": "Start/Explorer search: local only (no Bing, no web)", "uk": "Пошук у Пуску/Провіднику: лише локально (без Bing, без вебу)" },
      "description": { "en": "Search box no longer sends keystrokes to Bing; removes web results and Cortana consent.", "uk": "Поле пошуку не надсилає натискання в Bing; без веб-результатів і згоди Cortana." },
      "risk": "safe", "weight": 2, "tags": ["privacy", "recommended"], "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer", "name": "DisableSearchBoxSuggestions", "value": 1 },
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "BingSearchEnabled", "value": 0 },
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "CortanaConsent", "value": 0 },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search", "name": "DisableWebSearch", "value": 1 },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search", "name": "ConnectedSearchUseWeb", "value": 0 },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search", "name": "AllowCortana", "value": 0 },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search", "name": "AllowCloudSearch", "value": 0 },
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SearchSettings", "name": "IsDeviceSearchHistoryEnabled", "value": 0 }
      ]
    },
    {
      "id": "explorer.store-search-suggestions-off",
      "name": { "en": "Disable Microsoft Store suggestions in search", "uk": "Вимкнути пропозиції Microsoft Store у пошуку" },
      "description": { "en": "Search stops suggesting 'Install X from the Store' for apps you don't have (deny-ACL on store.db, Win11Debloat technique).", "uk": "Пошук перестає пропонувати «Встановити X зі Store» для відсутніх програм (Deny-ACL на store.db)." },
      "risk": "moderate", "weight": 1, "tags": ["ads"], "minBuild": 22621,
      "actions": [
        { "type": "powershell",
          "apply": "$p=\"$env:LOCALAPPDATA\\Packages\\Microsoft.WindowsStore_8wekyb3d8bbwe\\LocalState\\store.db\"; $d=Split-Path $p; if(-not (Test-Path $d)){New-Item $d -ItemType Directory -Force|Out-Null}; if(-not (Test-Path $p)){New-Item $p -ItemType File -Force|Out-Null}; $acl=Get-Acl $p; $rule=New-Object System.Security.AccessControl.FileSystemAccessRule('Everyone','FullControl','Deny'); $acl.AddAccessRule($rule); Set-Acl $p $acl",
          "revert": "$p=\"$env:LOCALAPPDATA\\Packages\\Microsoft.WindowsStore_8wekyb3d8bbwe\\LocalState\\store.db\"; if(Test-Path $p){ $acl=Get-Acl $p; $acl.Access | Where-Object { $_.AccessControlType -eq 'Deny' -and $_.IdentityReference -eq 'Everyone' } | ForEach-Object { $acl.RemoveAccessRule($_) | Out-Null }; Set-Acl $p $acl; Remove-Item $p -Force -ErrorAction SilentlyContinue }" }
      ]
    }
  ]
}
