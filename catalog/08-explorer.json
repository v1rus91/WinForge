      "risk": "safe", "weight": 0, "tags": ["explorer", "onedrive"], "restartExplorer": true, "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Classes\\CLSID\\{018D5C66-4533-4307-9B53-224DE2ED1FE6}", "name": "System.IsPinnedToNameSpaceTree", "value": 0 }
      ]
    },
    {
      "id": "explorer.hide-duplicate-drives",
