    {
      "id": "ai.input-insights",
      "name": { "en": "Disable Input Insights (typing telemetry for AI)", "uk": "Вимкнути Input Insights (телеметрія набору для AI)" },
      "description": { "en": "Disables the InputInsights scheduled task and the text-input insights setting.", "uk": "Вимикає заплановане завдання InputInsights та параметр «інсайти» текстового введення." },
      "risk": "safe", "weight": 1, "tags": ["ai", "telemetry"], "minBuild": 26100, "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Input\\Settings", "name": "InsightsEnabled", "value": 0 },
        { "type": "task", "path": "\\Microsoft\\Windows\\Input\\", "name": "InputInsights" }
      ]
    },
    {
      "id": "ai.settings-pages",
      "name": { "en": "Hide 'AI components' & 'App actions' in Settings", "uk": "Сховати «AI-компоненти» та «Дії застосунків» у Параметрах" },
      "description": { "en": "Adds hide:aicomponents;appactions to the Settings page visibility policy.", "uk": "Додає hide:aicomponents;appactions до політики видимості сторінок Параметрів." },
      "risk": "moderate", "weight": 0, "tags": ["ai", "ui"], "minBuild": 26100,
      "actions": [
        { "type": "powershell",
          "apply": "$k='HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer'; if(-not (Test-Path $k)){New-Item $k -Force|Out-Null}; $v=(Get-ItemProperty $k -Name SettingsPageVisibility -ErrorAction SilentlyContinue).SettingsPageVisibility; if(-not $v){$v='hide:'}; foreach($p in 'aicomponents','appactions'){ if($v -notmatch \"(^|;|:)$p(;|$)\"){ $v = $v.TrimEnd(';') + (if($v -match ':$'){''}else{';'}) + $p } }; Set-ItemProperty $k -Name SettingsPageVisibility -Value $v -Type String",
          "revert": "$k='HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer'; $v=(Get-ItemProperty $k -Name SettingsPageVisibility -ErrorAction SilentlyContinue).SettingsPageVisibility; if($v){ $v=($v -replace ';?aicomponents','' -replace ';?appactions','' -replace 'hide:;','hide:'); if($v -eq 'hide:'){Remove-ItemProperty $k -Name SettingsPageVisibility -ErrorAction SilentlyContinue}else{Set-ItemProperty $k -Name SettingsPageVisibility -Value $v} }" }
      ],
      "detect": [ { "type": "registryMatch", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "SettingsPageVisibility", "pattern": "aicomponents" } ]
    }
  ]
