    {
      "id": "ai.copilot",
      "name": { "en": "Disable Copilot & remove the Copilot app", "uk": "Вимкнути Copilot і видалити застосунок Copilot" },
      "description": { "en": "Policy-disables Windows Copilot, hides the taskbar button, blocks the shell extension and uninstalls the Microsoft.Copilot store package.", "uk": "Вимикає Windows Copilot політикою, ховає кнопку на панелі, блокує розширення оболонки та видаляє пакет Microsoft.Copilot." },
      "risk": "safe", "weight": 3, "tags": ["ai", "recommended"], "minBuild": 22621, "restartExplorer": true, "defaultUser": true,
      "actions": [
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "value": 1 },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "value": 1 },
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowCopilotButton", "value": 0 },
        { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Shell Extensions\\Blocked", "name": "{64134153-2E11-492F-8181-314091BA79A3}", "value": "Copilot", "kind": "String" },
        { "type": "appx", "name": "Microsoft.Copilot" },
        { "type": "appx", "name": "Microsoft.Windows.Copilot" },
        { "type": "appx", "name": "MicrosoftWindows.Client.Copilot" },
        { "type": "appx", "name": "Microsoft.Windows.Ai.Copilot.Provider" }
      ],
      "detect": [
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "value": 1 },
        { "type": "appx", "name": "Microsoft.Copilot" }
      ]
    },
    {
      "id": "ai.recall",
      "name": { "en": "Disable Windows Recall & snapshot saving", "uk": "Вимкнути Windows Recall і збереження знімків" },
      "description": { "en": "Blocks Recall enablement by policy, turns off snapshot saving and AI data analysis, disables Recall scheduled tasks and removes the optional feature.", "uk": "Блокує ввімкнення Recall політикою, вимикає збереження знімків та AI-аналіз, вимикає заплановані завдання Recall і видаляє необов’язковий компонент." },
